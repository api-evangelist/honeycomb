{
  "opencollection": "1.0.0",
  "info": {
    "name": "Honeycomb Environments API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Honeycomb-Team",
      "value": "{{X-Honeycomb-Team}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Environments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all environments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.honeycomb.io/1/environments"
          },
          "docs": "Returns a list of all environments within the team."
        },
        {
          "info": {
            "name": "Create an environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.honeycomb.io/1/environments",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new environment for separating telemetry data across stages such as development, staging, and production."
        },
        {
          "info": {
            "name": "Get an environment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.honeycomb.io/1/environments/:environmentId",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the environment."
              }
            ]
          },
          "docs": "Returns a single environment by its ID."
        },
        {
          "info": {
            "name": "Update an environment",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.honeycomb.io/1/environments/:environmentId",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the environment."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an environment's name, description, or color."
        },
        {
          "info": {
            "name": "Delete an environment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.honeycomb.io/1/environments/:environmentId",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the environment."
              }
            ]
          },
          "docs": "Deletes an environment."
        }
      ]
    },
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authenticate API key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.honeycomb.io/1/auth"
          },
          "docs": "Validates authentication for a key and returns the team and environment that the key belongs to."
        },
        {
          "info": {
            "name": "List authorizations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.honeycomb.io/1/auth/permissions"
          },
          "docs": "Determines what authorizations have been granted to the API key."
        }
      ]
    },
    {
      "info": {
        "name": "Key Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all API keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.honeycomb.io/1/api_keys"
          },
          "docs": "Returns a list of all API keys for the team."
        },
        {
          "info": {
            "name": "Create an API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.honeycomb.io/1/api_keys",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new API key for the team with specified permissions and environment scope."
        },
        {
          "info": {
            "name": "Get an API key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.honeycomb.io/1/api_keys/:keyId",
            "params": [
              {
                "name": "keyId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the API key."
              }
            ]
          },
          "docs": "Returns a single API key by its ID."
        },
        {
          "info": {
            "name": "Update an API key",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.honeycomb.io/1/api_keys/:keyId",
            "params": [
              {
                "name": "keyId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the API key."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an API key's name, permissions, or disabled status."
        },
        {
          "info": {
            "name": "Delete an API key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.honeycomb.io/1/api_keys/:keyId",
            "params": [
              {
                "name": "keyId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the API key."
              }
            ]
          },
          "docs": "Deletes an API key."
        }
      ]
    }
  ],
  "bundled": true
}