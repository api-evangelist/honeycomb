{
  "opencollection": "1.0.0",
  "info": {
    "name": "Honeycomb Auth Dataset Definitions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Honeycomb-Team",
      "value": "{{X-Honeycomb-Team}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Dataset Definitions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get dataset definition",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.honeycomb.io/1/dataset_definitions/:datasetSlug",
            "params": [
              {
                "name": "datasetSlug",
                "value": "",
                "type": "path",
                "description": "The slug identifier for the dataset. Dataset names are case insensitive."
              }
            ]
          },
          "docs": "Returns the dataset definition for the specified dataset, which configures how columns are interpreted and displayed."
        },
        {
          "info": {
            "name": "Update dataset definition",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.honeycomb.io/1/dataset_definitions/:datasetSlug",
            "params": [
              {
                "name": "datasetSlug",
                "value": "",
                "type": "path",
                "description": "The slug identifier for the dataset. Dataset names are case insensitive."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the dataset definition for the specified dataset."
        }
      ]
    }
  ],
  "bundled": true
}