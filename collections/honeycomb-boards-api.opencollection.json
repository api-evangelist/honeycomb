{
  "opencollection": "1.0.0",
  "info": {
    "name": "Honeycomb Auth Boards API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Honeycomb-Team",
      "value": "{{X-Honeycomb-Team}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Boards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all boards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.honeycomb.io/1/boards"
          },
          "docs": "Returns a list of all boards accessible in the current environment."
        },
        {
          "info": {
            "name": "Create a board",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.honeycomb.io/1/boards",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new board for organizing queries, SLO panels, and text panels."
        },
        {
          "info": {
            "name": "Get a board",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.honeycomb.io/1/boards/:boardId",
            "params": [
              {
                "name": "boardId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the board."
              }
            ]
          },
          "docs": "Returns a single board by its ID, including all queries and panels."
        },
        {
          "info": {
            "name": "Update a board",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.honeycomb.io/1/boards/:boardId",
            "params": [
              {
                "name": "boardId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the board."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a board's properties, queries, and panels."
        },
        {
          "info": {
            "name": "Delete a board",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.honeycomb.io/1/boards/:boardId",
            "params": [
              {
                "name": "boardId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the board."
              }
            ]
          },
          "docs": "Deletes a board."
        }
      ]
    }
  ],
  "bundled": true
}