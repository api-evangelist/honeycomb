{
  "opencollection": "1.0.0",
  "info": {
    "name": "Honeycomb Auth API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Honeycomb-Team",
      "value": "{{X-Honeycomb-Team}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authenticate API key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.honeycomb.io/1/auth"
          },
          "docs": "Validates authentication for a key and returns the team and environment that the key belongs to."
        },
        {
          "info": {
            "name": "List authorizations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.honeycomb.io/1/auth/permissions"
          },
          "docs": "Determines what authorizations have been granted to the API key."
        }
      ]
    }
  ],
  "bundled": true
}