{
  "opencollection": "1.0.0",
  "info": {
    "name": "Honeycomb Auth Query Data API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Honeycomb-Team",
      "value": "{{X-Honeycomb-Team}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Query Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Run a query and get data",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.honeycomb.io/1/query_data/:datasetSlug",
            "params": [
              {
                "name": "datasetSlug",
                "value": "",
                "type": "path",
                "description": "The slug identifier for the dataset."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submits a query specification and returns the result data directly. This is a convenience endpoint that combines query creation and result retrieval."
        }
      ]
    }
  ],
  "bundled": true
}