{
  "opencollection": "1.0.0",
  "info": {
    "name": "Honeycomb Auth Kinesis Events API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Honeycomb-Team",
      "value": "{{X-Honeycomb-Team}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Kinesis Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Kinesis events",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.honeycomb.io/1/kinesis_events/:datasetSlug",
            "params": [
              {
                "name": "datasetSlug",
                "value": "",
                "type": "path",
                "description": "The slug identifier for the dataset. Dataset names are case insensitive and may contain URL-encoded spaces or special characters but not URL-encoded slashes."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Processes streaming events from Amazon Kinesis into the specified Honeycomb dataset."
        }
      ]
    }
  ],
  "bundled": true
}